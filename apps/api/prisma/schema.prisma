generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("organization_status")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
  DELETED

  @@map("user_status")
}

enum TeamStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED

  @@map("team_status")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED

  @@map("project_status")
}

enum ProjectPaperStatus {
  ACTIVE
  ARCHIVED

  @@map("project_paper_status")
}

enum PaperAssignmentType {
  PRIMARY_READER
  COLLABORATOR
  REVIEWER

  @@map("paper_assignment_type")
}

enum PaperAssignmentStatus {
  ASSIGNED
  READING
  EXTRACTING
  SUBMITTED
  REVIEW
  REVISION_REQUIRED
  APPROVED
  COMPLETED
  CANCELLED

  @@map("paper_assignment_status")
}

enum PaperConflictResolution {
  BLOCKED
  COLLABORATION_REQUESTED
  APPROVED
  REJECTED

  @@map("paper_conflict_resolution")
}

enum ResearchAnswerType {
  TEXT
  LONG_TEXT
  NUMBER
  BOOLEAN
  DATE
  URL
  SELECT
  MULTI_SELECT

  @@map("research_answer_type")
}

enum ResearchSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  APPROVED
  COMPLETED

  @@map("research_submission_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  REVISION_REQUIRED
  BLOCKED
  COMPLETED
  CANCELLED

  @@map("task_status")
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("todo_status")
}

enum NoticePriority {
  URGENT
  IMPORTANT
  NORMAL

  @@map("notice_priority")
}

enum NoticeScope {
  CENTRAL
  TEAM
  INDIVIDUAL

  @@map("notice_scope")
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("notice_status")
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  RETIRED

  @@map("asset_condition")
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  LOST
  RETIRED

  @@map("asset_status")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(150)
  slug        String             @unique @db.VarChar(100)
  logoUrl     String?            @map("logo_url")
  description String?
  email       String?            @db.VarChar(255)
  phone       String?            @db.VarChar(50)
  timezone    String             @default("Asia/Dhaka") @db.VarChar(50)
  dateFormat  String             @default("YYYY-MM-DD") @map("date_format") @db.VarChar(30)
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  users         User[]
  roles         Role[]
  researchAreas ResearchArea[]
  skills        Skill[]
  teams         Team[]
  projects      Project[]
  papers        Paper[]
  questionSets  QuestionSet[]
  notices       Notice[]
  assets        Asset[]
  auditLogs     AuditLog[]
  notifications Notification[]
  exportJobs    ExportJob[]

  @@map("organizations")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  memberCode      String     @map("member_code") @db.VarChar(50)
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @map("password_hash")
  firstName       String     @map("first_name") @db.VarChar(100)
  lastName        String?    @map("last_name") @db.VarChar(100)
  fullName        String     @map("full_name") @db.VarChar(200)
  profileImageUrl String?    @map("profile_image_url")
  phone           String?    @db.VarChar(50)
  bio             String?
  joiningDate     DateTime?  @map("joining_date") @db.Date
  status          UserStatus @default(INVITED)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles               UserRole[]
  assignedUserRoles       UserRole[]                @relation("UserRoleAssigner")
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  directPermissions       UserPermission[]          @relation("UserDirectPermission")
  grantedPermissions      UserPermission[]          @relation("UserPermissionAssigner")
  userResearchAreas       UserResearchArea[]
  userSkills              UserSkill[]
  teamMemberships         TeamMember[]
  ledTeams                Team[]                    @relation("TeamLeader")
  assignedTeamMembers     TeamMember[]              @relation("TeamMemberAssignedBy")
  ownedProjects           Project[]                 @relation("ProjectOwner")
  createdProjects         Project[]                 @relation("ProjectCreatedBy")
  projectMemberships      ProjectMember[]
  createdPapers           Paper[]                   @relation("PaperCreatedBy")
  paperAssignments        PaperAssignment[]         @relation("PaperAssignmentUser")
  assignedPaperRecords    PaperAssignment[]         @relation("PaperAssignmentAssignedBy")
  createdProjectPapers    ProjectPaper[]            @relation("ProjectPaperAddedBy")
  requestedPaperConflicts PaperAssignmentConflict[] @relation("PaperConflictRequester")
  resolvedPaperConflicts  PaperAssignmentConflict[] @relation("PaperConflictResolver")
  researchResponses       ResearchResponse[]
  researchSubmissions     ResearchSubmission[]      @relation("ResearchSubmittedBy")
  reviewedSubmissions     ResearchSubmission[]      @relation("ResearchReviewedBy")
  createdQuestionSets     QuestionSet[]             @relation("QuestionSetCreatedBy")
  createdTasks            Task[]                    @relation("TaskCreatedBy")
  taskAssignments         TaskAssignee[]            @relation("TaskAssignedUser")
  assignedTasks           TaskAssignee[]            @relation("TaskAssigneeAssignedBy")
  createdTodos            Todo[]                    @relation("TodoCreatedBy")
  assignedTodos           Todo[]                    @relation("TodoAssignee")
  authoredNotices         Notice[]                  @relation("NoticeAuthor")
  noticeTargets           NoticeUser[]
  noticeAcknowledgements  NoticeAcknowledgement[]
  assignedAssetRecords    AssetAssignment[]         @relation("AssetAssignedUser")
  assetAssignmentActions  AssetAssignment[]         @relation("AssetAssignmentAssignedBy")
  createdAssets           Asset[]                   @relation("AssetCreatedBy")
  auditActions            AuditLog[]                @relation("AuditLogActor")
  notifications           Notification[]
  requestedExportJobs     ExportJob[]               @relation("ExportJobRequester")

  @@unique([organizationId, memberCode])
  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(50)
  code           String   @db.VarChar(50)
  description    String?
  isSystemRole   Boolean  @default(false) @map("is_system_role")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(150)
  module      String  @db.VarChar(100)
  action      String  @db.VarChar(50)
  description String?

  roles           RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner User? @relation("UserRoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  granted      Boolean  @default(true)
  assignedBy   String?  @map("assigned_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation("UserDirectPermission", fields: [userId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  assigner   User?      @relation("UserPermissionAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

model ResearchArea {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(150)
  slug           String   @db.VarChar(150)
  description    String?
  parentId       String?  @map("parent_id") @db.Uuid
  status         String   @default("ACTIVE") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       ResearchArea?         @relation("ResearchAreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     ResearchArea[]        @relation("ResearchAreaHierarchy")
  userAreas    UserResearchArea[]
  teams        TeamResearchArea[]
  projects     ProjectResearchArea[]
  papers       Paper[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("research_areas")
}

model UserResearchArea {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  researchAreaId String   @map("research_area_id") @db.Uuid
  proficiency    String?  @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  researchArea ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Restrict)

  @@unique([userId, researchAreaId])
  @@index([researchAreaId])
  @@map("user_research_areas")
}

model Skill {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  category       String?  @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        UserSkill[]

  @@unique([organizationId, name])
  @@map("skills")
}

model UserSkill {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  skillId         String   @map("skill_id") @db.Uuid
  proficiency     String?  @db.VarChar(30)
  yearsExperience Decimal? @map("years_experience") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model Team {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  teamCode       String     @map("team_code") @db.VarChar(50)
  name           String     @db.VarChar(150)
  description    String?
  imageUrl       String?    @map("image_url")
  teamLeaderId   String?    @map("team_leader_id") @db.Uuid
  startDate      DateTime?  @map("start_date") @db.Date
  targetDate     DateTime?  @map("target_date") @db.Date
  status         TeamStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teamLeader           User?              @relation("TeamLeader", fields: [teamLeaderId], references: [id], onDelete: Restrict)
  members              TeamMember[]
  researchAreas        TeamResearchArea[]
  projects             ProjectTeam[]
  projectRecords       Project[]
  tasks                Task[]
  todos                Todo[]
  notices              NoticeTeam[]
  assignedAssetRecords AssetAssignment[]  @relation("AssetAssignedTeam")

  @@unique([organizationId, teamCode])
  @@index([organizationId, status])
  @@map("teams")
}

model TeamMember {
  id             String    @id @default(uuid()) @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  membershipRole String?   @map("membership_role") @db.VarChar(50)
  joinedAt       DateTime? @map("joined_at") @db.Date
  leftAt         DateTime? @map("left_at") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  assignedBy     String?   @map("assigned_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  team     Team  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user     User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  assigner User? @relation("TeamMemberAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
  @@index([userId, isActive])
  @@map("team_members")
}

model TeamResearchArea {
  id             String @id @default(uuid()) @db.Uuid
  teamId         String @map("team_id") @db.Uuid
  researchAreaId String @map("research_area_id") @db.Uuid

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  researchArea ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Restrict)

  @@unique([teamId, researchAreaId])
  @@map("team_research_areas")
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  projectCode     String        @map("project_code") @db.VarChar(50)
  title           String        @db.VarChar(255)
  description     String?
  ownerId         String?       @map("owner_id") @db.Uuid
  defaultTeamId   String?       @map("default_team_id") @db.Uuid
  startDate       DateTime?     @map("start_date") @db.Date
  targetDate      DateTime?     @map("target_date") @db.Date
  status          ProjectStatus @default(PLANNING)
  progressPercent Decimal       @default(0) @map("progress_percent") @db.Decimal(5, 2)
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner               User?                     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator             User                      @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  defaultTeam         Team?                     @relation(fields: [defaultTeamId], references: [id], onDelete: Restrict)
  teams               ProjectTeam[]
  members             ProjectMember[]
  researchAreas       ProjectResearchArea[]
  papers              ProjectPaper[]
  assignments         PaperAssignment[]
  assignmentConflicts PaperAssignmentConflict[]
  questionSets        ProjectQuestionSet[]
  researchResponses   ResearchResponse[]
  researchSubmissions ResearchSubmission[]
  tasks               Task[]
  todos               Todo[]

  @@unique([organizationId, projectCode])
  @@index([organizationId, status])
  @@index([organizationId, targetDate])
  @@map("projects")
}

model ProjectTeam {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([projectId, teamId])
  @@index([teamId])
  @@map("project_teams")
}

model ProjectMember {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  projectRole String?   @map("project_role") @db.VarChar(50)
  joinedAt    DateTime? @map("joined_at") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectResearchArea {
  id             String @id @default(uuid()) @db.Uuid
  projectId      String @map("project_id") @db.Uuid
  researchAreaId String @map("research_area_id") @db.Uuid

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  researchArea ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Restrict)

  @@unique([projectId, researchAreaId])
  @@map("project_research_areas")
}

model Paper {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  paperCode       String   @unique @map("paper_code") @db.VarChar(50)
  title           String
  normalizedTitle String   @map("normalized_title")
  authors         Json?    @db.JsonB
  abstract        String?
  publicationYear Int?     @map("publication_year")
  journalName     String?  @map("journal_name") @db.VarChar(255)
  doi             String?  @db.VarChar(255)
  canonicalUrl    String?  @map("canonical_url")
  pdfUrl          String?  @map("pdf_url")
  imageUrl        String?  @map("image_url")
  publisher       String?  @db.VarChar(255)
  researchAreaId  String?  @map("research_area_id") @db.Uuid
  metadata        Json?    @db.JsonB
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  researchArea        ResearchArea?             @relation(fields: [researchAreaId], references: [id], onDelete: Restrict)
  creator             User                      @relation("PaperCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  identifiers         PaperIdentifier[]
  projectRecords      ProjectPaper[]
  assignments         PaperAssignment[]
  assignmentConflicts PaperAssignmentConflict[]
  researchResponses   ResearchResponse[]
  researchSubmissions ResearchSubmission[]

  @@unique([organizationId, normalizedTitle])
  @@unique([organizationId, doi])
  @@unique([organizationId, canonicalUrl])
  @@index([organizationId, normalizedTitle])
  @@index([organizationId, doi])
  @@index([publicationYear])
  @@map("papers")
}

model PaperIdentifier {
  id              String   @id @default(uuid()) @db.Uuid
  paperId         String   @map("paper_id") @db.Uuid
  identifierType  String   @map("identifier_type") @db.VarChar(50)
  identifierValue String   @map("identifier_value")
  normalizedValue String   @map("normalized_value")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Restrict)

  @@unique([identifierType, normalizedValue])
  @@index([paperId])
  @@map("paper_identifiers")
}

model ProjectPaper {
  id        String             @id @default(uuid()) @db.Uuid
  projectId String             @map("project_id") @db.Uuid
  paperId   String             @map("paper_id") @db.Uuid
  addedBy   String             @map("added_by") @db.Uuid
  addedAt   DateTime           @default(now()) @map("added_at") @db.Timestamptz(6)
  status    ProjectPaperStatus @default(ACTIVE)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  paper   Paper   @relation(fields: [paperId], references: [id], onDelete: Restrict)
  adder   User    @relation("ProjectPaperAddedBy", fields: [addedBy], references: [id], onDelete: Restrict)

  @@unique([projectId, paperId])
  @@index([paperId])
  @@map("project_papers")
}

model PaperAssignment {
  id              String                @id @default(uuid()) @db.Uuid
  projectId       String                @map("project_id") @db.Uuid
  paperId         String                @map("paper_id") @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  assignmentType  PaperAssignmentType   @map("assignment_type")
  status          PaperAssignmentStatus @default(ASSIGNED)
  assignedBy      String                @map("assigned_by") @db.Uuid
  startedAt       DateTime?             @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?             @map("completed_at") @db.Timestamptz(6)
  progressPercent Decimal               @default(0) @map("progress_percent") @db.Decimal(5, 2)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  project   Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  paper     Paper                     @relation(fields: [paperId], references: [id], onDelete: Restrict)
  user      User                      @relation("PaperAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  assigner  User                      @relation("PaperAssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)
  conflicts PaperAssignmentConflict[]

  @@index([projectId, paperId])
  @@index([userId, status])
  // PostgreSQL partial unique index is required for one active PRIMARY_READER;
  // Prisma schema DSL cannot represent this predicate. Add it in a SQL migration.
  @@map("paper_assignments")
}

model PaperAssignmentConflict {
  id                   String                  @id @default(uuid()) @db.Uuid
  projectId            String                  @map("project_id") @db.Uuid
  paperId              String                  @map("paper_id") @db.Uuid
  requestedBy          String                  @map("requested_by") @db.Uuid
  existingAssignmentId String                  @map("existing_assignment_id") @db.Uuid
  resolution           PaperConflictResolution @default(BLOCKED)
  resolvedBy           String?                 @map("resolved_by") @db.Uuid
  resolvedAt           DateTime?               @map("resolved_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  project            Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  paper              Paper           @relation(fields: [paperId], references: [id], onDelete: Restrict)
  requester          User            @relation("PaperConflictRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
