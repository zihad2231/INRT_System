model Task {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  taskCode        String       @map("task_code") @db.VarChar(50)
  title           String       @db.VarChar(255)
  description     String?
  projectId       String?      @map("project_id") @db.Uuid
  teamId          String?      @map("team_id") @db.Uuid
  createdBy       String       @map("created_by") @db.Uuid
  priority        TaskPriority @default(MEDIUM)
  status          TaskStatus   @default(TODO)
  startDate       DateTime?    @map("start_date") @db.Timestamptz(6)
  dueDate         DateTime?    @map("due_date") @db.Timestamptz(6)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(6)
  progressPercent Decimal      @default(0) @map("progress_percent") @db.Decimal(5, 2)
  parentTaskId    String?      @map("parent_task_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)

  project      Project?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  creator      User             @relation("TaskCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  parentTask   Task?            @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Restrict)
  childTasks   Task[]           @relation("TaskHierarchy")
  assignees    TaskAssignee[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents   TaskDependency[] @relation("TaskDependents")

  @@unique([organizationId, taskCode])
  @@index([organizationId, status, dueDate])
  @@index([projectId, status])
  @@index([teamId, status])
  @@map("tasks")
}

model TaskAssignee {
